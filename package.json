{
  "name": "arsam",
  "version": "2.0.3",
  "description": "Arsam Sarabi's portfolio in an interactive terminal app - A modern, type-safe CLI built with TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "fonts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/arsamsarabi/arsam-cli.git"
  },
  "author": {
    "name": "Arsam Sarabi",
    "email": "arsamsarabi@me.com",
    "url": "https://arsam.dev"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.3.10",
  "scripts": {
    "clean": "rm -rf dist",
    "bundle": "bun build src/index.ts --outdir dist --target node --minify --sourcemap=linked --format esm",
    "build": "bun run clean && bun run typecheck && bun run bundle",
    "dev": "bun ./src/index.ts",
    "start": "bun ./dist/index.js",
    "prettier": "prettier --write 'src/**/*.ts'",
    "lint": "eslint src",
    "tidy": "bun run lint && bun run prettier",
    "prepare": "husky install",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "boxen": "^7.0.1",
    "chalk": "^5.2.0",
    "chalk-animation": "^2.0.3",
    "clear": "^0.1.0",
    "figlet": "^1.5.2",
    "inquirer": "^9.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chalk-animation": "^1.6.1",
    "@types/clear": "^0.1.2",
    "@types/figlet": "^1.5.5",
    "@types/inquirer": "^9.0.3",
    "@types/node": "^20.0.0",
    "eslint": "^10.6.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.1.0",
    "prettier": "^2.8.3",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.62.1"
  },
  "bin": {
    "arsam": "./dist/index.js"
  },
  "keywords": [
    "arsam",
    "sarabi",
    "frontend",
    "backend",
    "fullstack",
    "engineer",
    "web developer",
    "react",
    "freelance",
    "node",
    "graphql",
    "redux",
    "next",
    "nextjs",
    "react native",
    "react-native",
    "svelte",
    "sveltekit",
    "typescript",
    "javascript",
    "terminal",
    "cli",
    "portfolio",
    "styled-components",
    "tailwind"
  ]
}
