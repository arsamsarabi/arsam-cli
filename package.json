{
  "name": "arsam",
  "version": "2.0.3",
  "description": "Arsam Sarabi's portfolio in an interactive terminal app - A modern, type-safe CLI built with TypeScript",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "fonts"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:arsamsarabi/arsam-cli.git"
  },
  "author": {
    "name": "Arsam Sarabi",
    "email": "arsamsarabi@me.com",
    "url": "https://arsam.dev"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "esbuild": "node esbuild.config.mjs",
    "build": "yarn clean && yarn typecheck && yarn esbuild",
    "dev": "tsx ./src/index.ts",
    "start": "node ./dist/index.js",
    "prettier": "prettier --write 'src/**/*.ts'",
    "lint": "eslint src",
    "tidy": "yarn lint && yarn prettier",
    "prepare": "husky install",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "boxen": "^7.0.1",
    "chalk": "^5.2.0",
    "chalk-animation": "^2.0.3",
    "clear": "^0.1.0",
    "figlet": "^1.5.2",
    "gradient-string": "^2.0.2",
    "inquirer": "^9.1.4"
  },
  "devDependencies": {
    "@types/chalk-animation": "^1.6.1",
    "@types/clear": "^0.1.2",
    "@types/figlet": "^1.5.5",
    "@types/inquirer": "^9.0.3",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.33.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.1.0",
    "prettier": "^2.8.3",
    "rimraf": "^5.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  },
  "bin": {
    "arsam": "./dist/index.js"
  },
  "keywords": [
    "arsam",
    "sarabi",
    "frontend",
    "backend",
    "fullstack",
    "engineer",
    "web developer",
    "react",
    "freelance",
    "node",
    "graphql",
    "redux",
    "next",
    "nextjs",
    "react native",
    "react-native",
    "svelte",
    "sveltekit",
    "typescript",
    "javascript",
    "terminal",
    "cli",
    "portfolio",
    "styled-components",
    "tailwind"
  ]
}
